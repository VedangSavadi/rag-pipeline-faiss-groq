         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Enterprise Data Platform &amp; Control Tower for Automotive</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Discover how Mahindra built a unified data platform and C-suite control tower delivering real-time insights, 2000+ KPIs, and enterprise-wide decision intelligence.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:creator>
            <rdf:Bag>
               <rdf:li>Tech Mahindra</rdf:li>
            </rdf:Bag>
         </dc:creator>
         <dc:subject>
